[sub_resource type="Resource" id="Resource_tdb8c"]
script = ExtResource("1_fwdl7")
speaker_name = "???"
speaker_portrait = ExtResource("3_fwdl7")
text = "Imagine how broke you'd be if it weren't for me."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_xe4qa"]
script = ExtResource("1_fwdl7")
speaker_name = "???"
speaker_portrait = ExtResource("3_fwdl7")
text = "You'd probably still be working as a lab assistant."
