[ext_resource type="Script" uid="uid://drvyi1grf150r" path="res://scripts/dialogue/dialogue_line.gd" id="1_eoe5y"]
[ext_resource type="Texture2D" uid="uid://cgyimct3i3kis" path="res://assets/characters/Cameron_Icon.png" id="2_qwx68"]
[ext_resource type="Script" uid="uid://6av67jfqula5" path="res://scripts/dialogue/dialogue.gd" id="3_2ks5y"]

[sub_resource type="Resource" id="Resource_qri7n"]
script = ExtResource("1_eoe5y")
speaker_name = "???"
text = "I can’t wait to see Henry! "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_fkt8q"]
script = ExtResource("1_eoe5y")
speaker_name = "???"
text = "I’ll tell him about my new job. The library was so boring. I’m basically Shrimplock Holmes now."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_w1d6m"]
script = ExtResource("1_eoe5y")
speaker_name = "Shrimplock Holmes"
text = "But we’ll have to see whether he’s home. I haven’t told him that I’m coming over."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_fvmgg"]
script = ExtResource("1_eoe5y")
speaker_name = "Shrimlock Holmes"
speaker_portrait = ExtResource("2_qwx68")
text = "I wanted to surprise him! I even made his favorite salad. He eats healthy, unlike me. 
"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_6g26k"]
script = ExtResource("1_eoe5y")
speaker_name = "Shrimlock Holmes"
text = "We’ll play games, read comics, all day, all summer. And now that we’re all grown up, we don’t have anyone nagging us!
"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_nanmv"]
script = ExtResource("1_eoe5y")
speaker_name = "Shrimlock Holmes"
text = "Oh, there’s the house! It looks just like I remember. 
"
metadata/_custom_type_script = "uid://drvyi1grf150r"

