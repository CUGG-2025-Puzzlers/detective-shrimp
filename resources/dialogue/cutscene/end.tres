[gd_resource type="Resource" script_class="Dialogue" load_steps=27 format=3 uid="uid://bnjxmbryu7tgy"]

[ext_resource type="Script" uid="uid://drvyi1grf150r" path="res://scripts/dialogue/dialogue_line.gd" id="1_mgxjn"]
[ext_resource type="Texture2D" uid="uid://ovdothn0jexs" path="res://textures/cameron/cameron_real.png" id="2_ud5mk"]
[ext_resource type="Script" uid="uid://6av67jfqula5" path="res://scripts/dialogue/dialogue.gd" id="4_vje1i"]

[sub_resource type="Resource" id="Resource_qri7n"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Why am I here again?"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_ud5mk"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I’m scared."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_mgxjn"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "It’s all my fault isn’t it?"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_bmv0p"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I can’t fix what happened. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_x4wt7"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Apologizing won’t fix anything. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_vje1i"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Apologizing won’t bring Henry back."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_ogpa3"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I’m unforgivable."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_vv1en"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Why can’t everything just be like Shrimptective? Why can’t i just solve the mystery, and teach the bad guys a lesson?"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_0d7bg"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Why do I have to ruin everything?"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_pbr2v"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Henry, I’m sorry. You were right. Again."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_hsqph"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I should have just listened to you. I thought I needed the money. The drugs."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_44apg"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "But nothing will bring you back."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_km1ot"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I deserve to be in your place. I was always too rough, but you were too soft. You should have fought back."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_v1kh3"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "You were like dad, kind and optimistic. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_u5s2a"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "It’s no wonder you were picked on, heh."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_djk0j"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "What you said about turning over a new leaf stuck with me. I can’t say I’m perfect, but I’ve been trying my best."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_n8fw7"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I got a job at the library, picked up drawing, and started rehab. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_j2mm8"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I even have a girlfriend now! "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_jsltg"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "But it’s hard. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_wp8eh"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I made a mistake today, and that’s why I’m here. Again."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_t86fy"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I’m sorry, Henry. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_ivce4"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "I can’t fix what I’ve done, but I’ll live a life you’re proud of. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_hjnro"]
script = ExtResource("1_mgxjn")
speaker_name = "Cameron"
speaker_portrait = ExtResource("2_ud5mk")
text = "Thanks for everything, brother."
metadata/_custom_type_script = "uid://drvyi1grf150r"

