[sub_resource type="Resource" id="Resource_qri7n"]
script = ExtResource("1_0jo7d")
speaker_name = "???"
speaker_portrait = ExtResource("2_23by0")
text = "I can’t wait to see Henry! "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_nanmv"]
script = ExtResource("1_0jo7d")
speaker_name = "???"
speaker_portrait = ExtResource("3_23by0")
text = "I’ll tell him about my new job. The library was so boring. I’m basically Shrimplock Holmes now."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_ad5bv"]
script = ExtResource("1_0jo7d")
speaker_name = "Shrimplock Holmes"
speaker_portrait = ExtResource("3_23by0")
text = "But we’ll have to see if he’s home. I haven’t told him that I’m coming over."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_tnlbc"]
script = ExtResource("1_0jo7d")
speaker_name = "Shrimplock Holmes"
speaker_portrait = ExtResource("2_23by0")
text = "I wanted to surprise him! I even made his favorite salad. "
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_wjgfu"]
script = ExtResource("1_0jo7d")
speaker_name = "Shrimplock Holmes"
speaker_portrait = ExtResource("3_23by0")
text = "He eats healthy, unlike me."
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_23by0"]
script = ExtResource("1_0jo7d")
speaker_name = "Shrimplock Holmes"
speaker_portrait = ExtResource("2_23by0")
text = "We’ll play games, read comics, all day. Now that we’re older, we can stay up all night!"
metadata/_custom_type_script = "uid://drvyi1grf150r"

[sub_resource type="Resource" id="Resource_tg7ff"]
script = ExtResource("1_0jo7d")
speaker_name = "Shrimplock Holmes"
speaker_portrait = ExtResource("2_23by0")
text = "Oh, there’s the house! It looks just like I remember."
metadata/_custom_type_script = "uid://drvyi1grf150r"

