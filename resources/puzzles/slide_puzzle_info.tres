[resource]
script = ExtResource("1_dn08d")
title = "Mailbox Key Slide"
description = "Hmm... I can't get a good grip on the key with all this mail in the way. Maybe if I could figure out how to move things around, I could get the key!"
objective = "Get the key to the bottom right corner by moving the blocks of mail around. Click and drag a piece to move it into a free cell and stop dragging to let it go."
